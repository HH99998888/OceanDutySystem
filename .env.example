# 仅复制为本机 .env 或由服务器密钥管理服务注入；不要填写或提交真实密码。
OCEAN_ALARM_DB_ENABLED=true
OCEAN_ALARM_DB_URL=jdbc:mysql://<host>:<port>/hyyj?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
OCEAN_ALARM_DB_USERNAME=<readonly-username>
OCEAN_ALARM_DB_PASSWORD=<readonly-password>

# 智能网格 PostgreSQL 只读连接。
OCEAN_GRID_DB_ENABLED=true
OCEAN_GRID_DB_URL=jdbc:postgresql://<host>:<port>/hyyj
OCEAN_GRID_DB_USERNAME=<readonly-username>
OCEAN_GRID_DB_PASSWORD=<readonly-password>

# 智能网格 FTP 只读连接；目录名称可按实际服务器目录调整。
OCEAN_GRID_FTP_ENABLED=true
OCEAN_GRID_FTP_HOST=<ftp-host>
OCEAN_GRID_FTP_PORT=21
OCEAN_GRID_FTP_USERNAME=<readonly-username>
OCEAN_GRID_FTP_PASSWORD=<readonly-password>
OCEAN_GRID_FTP_OUTPUT_DIRECTORY=/OutputData
OCEAN_GRID_FTP_ROOT_DIRECTORY=/
OCEAN_GRID_FTP_WIND_DIRECTORY=wind
OCEAN_GRID_FTP_WAVE_DIRECTORY=wave
OCEAN_GRID_FTP_CURRENT_DIRECTORY=current
OCEAN_GRID_FTP_SST_DIRECTORY=sst
OCEAN_GRID_FTP_TIDE_DIRECTORY=storm_tide
